    },
    {
      "page": "/api/ai/analyze-audience",
      "regex": "^/api/ai/analyze\\-audience(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/ai/analyze\\-audience(?:/)?$"
    },
    {

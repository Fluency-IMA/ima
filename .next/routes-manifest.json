      "namedRegex": "^/admin/influencers(?:/)?$"
    },
    {
      "page": "/admin/legal-ai",
      "regex": "^/admin/legal\\-ai(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/legal\\-ai(?:/)?$"
    },
    {
      "page": "/admin/login",
      "regex": "^/admin/login(?:/)?$",
      "routeKeys": {},
